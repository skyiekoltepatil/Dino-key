  server.on("/api/sync", HTTP_GET, []() {
    if (server.hasArg("utc")) {
      uint32_t utc = (uint32_t)strtoul(server.arg("utc").c_str(), nullptr, 10);
      int32_t tzm = server.hasArg("tzmin") ? (int32_t)atol(server.arg("tzmin").c_str()) : tzOffsetMin;
      if (utc > 1700000000UL) {
