  prefs.begin("dinokey", false);
  tzOffsetMin = prefs.getLong("tzmin", DEFAULT_TZ_MIN);
  wifiSsid1 = prefs.getString("ssid1", ""); wifiPass1 = prefs.getString("pass1", "");
  wifiSsid2 = prefs.getString("ssid2", ""); wifiPass2 = prefs.getString("pass2", "");
  dinoBest = max(dinoBest, (uint32_t)prefs.getULong("dino_hi", 0));
  brightnessLevel = (uint8_t)constrain((int)prefs.getUChar("bri_lvl", 5), 1, 5);

  uint32_t nvsEp = prefs.getULong("epoch", 0), compEp = DateTime(F(__DATE__), F(__TIME__)).unixtime() + 5;
  uint32_t seed = max(compEp, nvsEp);
  if (softBuildTag == compEp && softEpochSaved > seed) seed = softEpochSaved;
  softBuildTag = compEp; softEpochSaved = seed; lastSoftTickMs = lastNvsSaveMs = millis();
  cachedNow = DateTime(seed); timeSource = (nvsEp >= compEp) ? "NVS" : "EST";
}

void saveWifiCredentials(int slot, const String& ssid, const String& pass) {
  if (ssid.length() == 0) return;
  if (slot == 2) {
    wifiSsid2 = ssid; wifiPass2 = pass; prefs.putString("ssid2", ssid); prefs.putString("pass2", pass); wifiActiveSlot = 1;
  } else {
    if (wifiSsid1.length() > 0 && wifiSsid1 != ssid) {
      wifiSsid2 = wifiSsid1; wifiPass2 = wifiPass1; prefs.putString("ssid2", wifiSsid2); prefs.putString("pass2", wifiPass2);
    }
    wifiSsid1 = ssid; wifiPass1 = pass; prefs.putString("ssid1", ssid); prefs.putString("pass1", pass); wifiActiveSlot = 0;
  }
  wifiState = STA_IDLE; wifiStateMs = 0;
}

void clearWifiCredentials() {
  wifiSsid1 = wifiPass1 = wifiSsid2 = wifiPass2 = activeStaSsid = "";
  prefs.putString("ssid1", ""); prefs.putString("pass1", "");
  prefs.putString("ssid2", ""); prefs.putString("pass2", "");
  WiFi.disconnect(false); wifiState = STA_COOLDOWN; wifiStateMs = millis();
}

bool getSlotCreds(int slot, String& s, String& p) {
  if (slot == 0 && wifiSsid1.length() > 0) { s = wifiSsid1; p = wifiPass1; return true; }
  if (slot == 1 && wifiSsid2.length() > 0) { s = wifiSsid2; p = wifiPass2; return true; }
  if (slot == 2 && strcmp(WIFI_SSID, "YourWiFiName") != 0 && strlen(WIFI_SSID) > 0) { s = WIFI_SSID; p = WIFI_PASS; return true; }
  return false;
}
bool hasAnyWifiConfigured() { String s, p; return getSlotCreds(0, s, p) || getSlotCreds(1, s, p) || getSlotCreds(2, s, p); }

bool getBatInfo(bool& hasBat, float& pct, bool& fromBle, bool& chg) {
  fromBle = !batteryAvailable && (bleHostBatValid || bleClientConnected);
  hasBat = batteryAvailable || fromBle;
  pct = batteryAvailable ? batPercent : (bleHostBatValid ? bleHostBatPct : (float)lastBleBatSent);
  chg = batteryAvailable ? (batChargeRate > 0.05f) : bleHostBatCharging;
  return hasBat;
}

String buildStatusJson() {
  char ds[20], ts[16]; formatDateStr(ds, sizeof(ds)); formatTimeStr(ts, sizeof(ts), false);
  String wf = (WiFi.status() == WL_CONNECTED) ? activeStaSsid : (hasAnyWifiConfigured() ? (wifiState == STA_CONNECTING ? "Connecting..." : "Offline") : "AP Only");
  String ip = (WiFi.status() == WL_CONNECTED) ? WiFi.localIP().toString() : "";
  bool hasBat, fromBle, chg; float pct; getBatInfo(hasBat, pct, fromBle, chg);
  int effBat = hasBat ? (int)pct : -1;
  const char* batSrc = batteryAvailable ? "MAX17048" : (fromBle ? "BLE" : "NONE");
  return String("{\"time\":\"") + ts + "\",\"date\":\"" + ds + "\",\"sync\":\"" + timeSource +
         "\",\"live\":" + (timeSyncedLive ? "true" : "false") + ",\"bat\":" + effBat +
         ",\"batSrc\":\"" + batSrc + "\",\"batChg\":" + (chg ? "true" : "false") +
         ",\"wifi\":\"" + wf + "\",\"staIp\":\"" + ip + "\",\"ap\":\"" + AP_SSID +
         "\",\"apIp\":\"" + WiFi.softAPIP().toString() + "\",\"apClients\":" + WiFi.softAPgetStationNum() +
         ",\"ssid1\":\"" + wifiSsid1 + "\",\"ssid2\":\"" + wifiSsid2 + "\",\"bri\":" + (int)brightnessLevel +
         ",\"bleConn\":" + (bleClientConnected ? "true" : "false") + "}";
}

void updateBleStatusValue(bool notifyClients = false) {
  if (bleCmdChar) {
    bleCmdChar->setValue(buildStatusJson().c_str());
    if (notifyClients && bleClientConnected) bleCmdChar->notify();
  }
  if (bleBatChar) {
    uint8_t lvl = batteryAvailable ? (uint8_t)constrain((int)batPercent, 0, 100) : 100;
    bleBatChar->setValue(&lvl, 1); lastBleBatSent = lvl;
    if (notifyClients && bleClientConnected) bleBatChar->notify();
  }
}

void executeSyncCommand(const String& rawIn, const char* viaSrc) {
  String cmd = rawIn; cmd.trim();
  if (cmd.length() == 0) return;
  lastActivityMs = millis();
  if (currentMode == MODE_SLEEP) { currentMode = previousMode; u8g2.setContrast(activeContrast()); }

  if (cmd.startsWith("T:")) {
    int p1 = cmd.indexOf(':', 2), p2 = (p1 > 0) ? cmd.indexOf(':', p1 + 1) : -1, p3 = (p2 > 0) ? cmd.indexOf(':', p2 + 1) : -1;
    uint32_t utc = (uint32_t)strtoul((p1 > 0 ? cmd.substring(2, p1) : cmd.substring(2)).c_str(), nullptr, 10);
    int32_t tzm = (p1 > 0) ? (int32_t)atol((p2 > 0 ? cmd.substring(p1 + 1, p2) : cmd.substring(p1 + 1)).c_str()) : tzOffsetMin;
    if (utc > 1700000000UL) { bleGotDirectCmd = true; applyUtcAndTz(utc, tzm, viaSrc); }
    if (p2 > 0) {
      int bPct = atoi((p3 > 0 ? cmd.substring(p2 + 1, p3) : cmd.substring(p2 + 1)).c_str());
      bool chg = (p3 > 0) && (atoi(cmd.substring(p3 + 1).c_str()) != 0);
      if (bPct >= 0 && bPct <= 100) { bleHostBatPct = (float)bPct; bleHostBatCharging = chg; bleHostBatValid = true; }
    }
  } else if (cmd.startsWith("BAT:")) {
    int sep = cmd.indexOf(':', 4), bPct = atoi((sep > 0 ? cmd.substring(4, sep) : cmd.substring(4)).c_str());
    bool chg = (sep > 0) && (atoi(cmd.substring(sep + 1).c_str()) != 0);
    if (bPct >= 0 && bPct <= 100) { bleHostBatPct = (float)bPct; bleHostBatCharging = chg; bleHostBatValid = true; }
  } else if (cmd.startsWith("EPOCH ")) {
    unsigned long utc = 0; long tzm = tzOffsetMin;
    if (sscanf(cmd.c_str() + 6, "%lu %ld", &utc, &tzm) >= 1 && utc > 1700000000UL) { bleGotDirectCmd = true; applyUtcAndTz((uint32_t)utc, (int32_t)tzm, viaSrc); }
  } else if (cmd.startsWith("SET ")) {
    int y, mo, d, hh, mm, ss;
    if (sscanf(cmd.c_str() + 4, "%d-%d-%d %d:%d:%d", &y, &mo, &d, &hh, &mm, &ss) == 6) { bleGotDirectCmd = true; setLocalEpoch(DateTime(y, mo, d, hh, mm, ss).unixtime(), viaSrc, true, true); }
  } else if (cmd.startsWith("W:") || cmd.startsWith("WIFI ")) {
    String pay = cmd.startsWith("W:") ? cmd.substring(2) : cmd.substring(5);
    int sep = pay.indexOf('|');
    if (sep > 0) { String s = pay.substring(0, sep); s.trim(); saveWifiCredentials(1, s, pay.substring(sep + 1)); }
  } else if (cmd.startsWith("M:")) { int m = atoi(cmd.c_str() + 2); if (m >= 0 && m < 8) currentMode = (ScreenMode)m; }
  else if (cmd.startsWith("F:")) { int f = atoi(cmd.c_str() + 2); if (f >= 0 && f < 20) faceIdx = f; }
  else if (cmd.startsWith("B:")) { setBrightnessLevel((uint8_t)atoi(cmd.c_str() + 2), true); }
  else if (cmd == "SW:TOGGLE") toggleStopwatch();
  else if (cmd == "SW:RESET") resetStopwatch();
  else if (cmd == "CLR") clearWifiCredentials();
  else if (cmd == "STATUS") Serial.println(buildStatusJson());
  updateBleStatusValue(true);
}

int onBleBatReadCb(uint16_t, const struct ble_gatt_error* err, struct ble_gatt_attr* attr, void*) {
  if (err && err->status == 0 && attr && attr->om && OS_MBUF_PKTLEN(attr->om) >= 1) {
    uint8_t val = 0; os_mbuf_copydata(attr->om, 0, 1, &val);
    if (val <= 100) {
      portENTER_CRITICAL(&bleMux);
      bleHostBatVal = val; bleHostBatPending = true; bleNextBatPollMs = millis() + 60000UL; bleCtsState = CTS_DONE;
      portEXIT_CRITICAL(&bleMux); return 0;
    }
  }
  setCtsState(CTS_DONE); return 0;
}

int onBleBatChrCb(uint16_t ch, const struct ble_gatt_error* err, const struct ble_gatt_chr* chr, void*) {
  if (!err) return 0;
  if (err->status == 0 && chr) {
    if (chr->uuid.u.type == BLE_UUID_TYPE_16 && chr->uuid.u16.value == 0x2A19) { portENTER_CRITICAL(&bleMux); blePeerBatHandle = chr->val_handle; portEXIT_CRITICAL(&bleMux); }
    return 0;
  }
  portENTER_CRITICAL(&bleMux);
  if (bleClientConnected && ch == activeBleConnHandle) { bleCtsState = blePeerBatHandle ? CTS_READ_BAT : CTS_DONE; bleNextCtsProbeMs = millis() + 40UL; }
  portEXIT_CRITICAL(&bleMux); return 0;
}

int onBleBatSvcCb(uint16_t ch, const struct ble_gatt_error* err, const struct ble_gatt_svc* svc, void*) {
  if (!err) return 0;
  if (err->status == 0 && svc) { portENTER_CRITICAL(&bleMux); bleBatSvcStart = svc->start_handle; bleBatSvcEnd = svc->end_handle; portEXIT_CRITICAL(&bleMux); return 0; }
  portENTER_CRITICAL(&bleMux);
  if (bleClientConnected && ch == activeBleConnHandle) {
    if (bleBatSvcStart && bleBatSvcEnd >= bleBatSvcStart) { bleCtsState = CTS_DISC_BAT_CHR; bleNextCtsProbeMs = millis() + 40UL; }
    else bleCtsState = CTS_DONE;
  }
  portEXIT_CRITICAL(&bleMux); return 0;
}

int onBleCtsTimeReadCb(uint16_t, const struct ble_gatt_error* err, struct ble_gatt_attr* attr, void*) {
  if (!err) return 0;
  if (err->status == 0 && attr && attr->om && OS_MBUF_PKTLEN(attr->om) >= 7) {
    uint8_t b[10]; uint16_t len = min((uint16_t)10, OS_MBUF_PKTLEN(attr->om)); os_mbuf_copydata(attr->om, 0, len, b);
    uint16_t yr = (uint16_t)b[0] | ((uint16_t)b[1] << 8);
    if (yr >= 2024 && yr <= 2099 && b[2] >= 1 && b[2] <= 12 && b[3] >= 1 && b[3] <= 31 && b[4] < 24 && b[5] < 60 && b[6] < 60) {
      portENTER_CRITICAL(&bleMux);
      bleCtsLocalEpoch = DateTime(yr, b[2], b[3], b[4], b[5], b[6]).unixtime();
      bleCtsPending = true; bleCtsState = blePeerBatHandle ? CTS_READ_BAT : CTS_DISC_BAT_SVC; bleNextCtsProbeMs = millis() + 60UL;
      portEXIT_CRITICAL(&bleMux); return 0;
    }
  }
  portENTER_CRITICAL(&bleMux);
  bleCtsLastErr = err->status;
  if (bleCtsAttempt < 10) { bleCtsAttempt++; bleCtsState = CTS_READ_TIME; bleNextCtsProbeMs = millis() + 1500UL; }
  else { bleCtsState = CTS_DISC_BAT_SVC; bleNextCtsProbeMs = millis() + 60UL; bleCtsLogNoCts = true; }
  portEXIT_CRITICAL(&bleMux); return 0;
}

int onBleCtsLocalReadCb(uint16_t ch, const struct ble_gatt_error* err, struct ble_gatt_attr* attr, void*) {
  if (err && err->status == 0 && attr && attr->om && OS_MBUF_PKTLEN(attr->om) >= 1) {
    uint8_t b[4] = {0}; uint16_t len = min((uint16_t)4, OS_MBUF_PKTLEN(attr->om)); os_mbuf_copydata(attr->om, 0, len, b);
    int8_t q = (int8_t)b[0];
    if (q >= -48 && q <= 56) {
      int32_t tzm = (int32_t)q * 15 + ((len >= 2 && (b[1] == 2 || b[1] == 4 || b[1] == 8)) ? (int32_t)b[1] * 15 : 0);
      portENTER_CRITICAL(&bleMux); bleCtsTzMin = tzm; bleCtsHasTz = true; portEXIT_CRITICAL(&bleMux);
    }
  }
  portENTER_CRITICAL(&bleMux);
  if (bleClientConnected && ch == activeBleConnHandle) { bleCtsState = bleCtsTimeHandle ? CTS_READ_TIME : CTS_DONE; bleNextCtsProbeMs = millis() + 40UL; }
  portEXIT_CRITICAL(&bleMux); return 0;
}

int onBleCtsChrCb(uint16_t ch, const struct ble_gatt_error* err, const struct ble_gatt_chr* chr, void*) {
  if (!err) return 0;
  if (err->status == 0 && chr) {
    if (chr->uuid.u.type == BLE_UUID_TYPE_16) {
      portENTER_CRITICAL(&bleMux);
      if (chr->uuid.u16.value == 0x2A2B) bleCtsTimeHandle = chr->val_handle;
      else if (chr->uuid.u16.value == 0x2A0F) bleCtsLocalHandle = chr->val_handle;
      portEXIT_CRITICAL(&bleMux);
    }
    return 0;
  }
  portENTER_CRITICAL(&bleMux);
  if (bleClientConnected && ch == activeBleConnHandle) {
    if (bleCtsTimeHandle) { bleCtsState = bleCtsLocalHandle ? CTS_READ_LOCAL : CTS_READ_TIME; bleNextCtsProbeMs = millis() + 40UL; }
    else { bleCtsLastErr = err->status; bleCtsState = CTS_DONE; bleCtsLogNoCts = true; }
  }
  portEXIT_CRITICAL(&bleMux); return 0;
}

int onBleCtsSvcCb(uint16_t ch, const struct ble_gatt_error* err, const struct ble_gatt_svc* svc, void*) {
  if (!err) return 0;
  if (err->status == 0 && svc) { portENTER_CRITICAL(&bleMux); bleCtsSvcStart = svc->start_handle; bleCtsSvcEnd = svc->end_handle; portEXIT_CRITICAL(&bleMux); return 0; }
  portENTER_CRITICAL(&bleMux);
  if (bleClientConnected && ch == activeBleConnHandle) {
    if (bleCtsSvcStart && bleCtsSvcEnd >= bleCtsSvcStart) { bleCtsState = CTS_DISC_CHR; bleCtsLogFound = true; bleNextCtsProbeMs = millis() + 40UL; }
    else {
      bleCtsLastErr = err->status;
      if (bleCtsAttempt < 10) { bleCtsAttempt++; bleCtsState = CTS_DISC_SVC; bleNextCtsProbeMs = millis() + 2500UL; }
      else { bleCtsState = CTS_DISC_BAT_SVC; bleNextCtsProbeMs = millis() + 60UL; bleCtsLogNoCts = true; }
    }
  }
  portEXIT_CRITICAL(&bleMux); return 0;
}

void startBleAdvertising() {
  NimBLEAdvertising* adv = NimBLEDevice::getAdvertising();
  adv->setAdvertisementData(bleAdvData); adv->setScanResponseData(bleScanData);
  adv->setScanResponse(true); adv->start();
}

class DinoBleServerCb : public NimBLEServerCallbacks {
  void onConnect(NimBLEServer*, ble_gap_conn_desc* desc) override {
    portENTER_CRITICAL(&bleMux);
    bleClientConnected = true; activeBleConnHandle = desc->conn_handle; bleConnAtMs = millis();
    bleCtsEncrypted = (desc->sec_state.encrypted != 0); bleCtsSecStarted = bleCtsEncrypted;
    bleGotDirectCmd = bleHostBatValid = bleHostBatPending = false;
    bleCtsSvcStart = bleCtsSvcEnd = bleCtsTimeHandle = bleCtsLocalHandle = 0;
    bleBatSvcStart = bleBatSvcEnd = blePeerBatHandle = 0;
    bleNextBatPollMs = bleCtsAttempt = bleCtsLastErr = 0; bleCtsHasTz = false;
    bleCtsLogFound = bleCtsLogNoCts = false; bleCtsLogAuth = bleCtsEncrypted;
    bleCtsState = bleCtsEncrypted ? CTS_DISC_SVC : CTS_WAIT_SEC;
    bleNextCtsProbeMs = bleConnAtMs + (bleCtsEncrypted ? 450UL : 500UL);
    portEXIT_CRITICAL(&bleMux);
  }
  void onAuthenticationComplete(ble_gap_conn_desc* desc) override {
    if (!desc->sec_state.encrypted) return;
    portENTER_CRITICAL(&bleMux);
    bleCtsEncrypted = bleCtsSecStarted = bleSvcChangedPending = bleCtsLogAuth = true;
    bleCtsAttempt = bleCtsSvcStart = bleCtsSvcEnd = bleCtsTimeHandle = bleCtsLocalHandle = 0;
    bleCtsState = CTS_DISC_SVC; bleNextCtsProbeMs = millis() + 450UL;
    portEXIT_CRITICAL(&bleMux);
  }
  void onDisconnect(NimBLEServer*) override {
    portENTER_CRITICAL(&bleMux);
    bleClientConnected = bleCtsEncrypted = bleCtsSecStarted = bleHostBatPending = bleHostBatValid = false;
    blePeerBatHandle = bleNextBatPollMs = 0; bleCtsState = CTS_IDLE; bleNextCtsProbeMs = 0;
    portEXIT_CRITICAL(&bleMux);
    startBleAdvertising();
  }
} dinoBleServerCb;

class DinoBleCharCb : public NimBLECharacteristicCallbacks {
  void onRead(NimBLECharacteristic* c) override { c->setValue(buildStatusJson().c_str()); }
  void onWrite(NimBLECharacteristic* c) override {
    std::string v = c->getValue(); if (v.empty()) return;
    portENTER_CRITICAL(&bleMux);
    size_t n = min(v.size(), sizeof(bleCmdBuf) - 1); memcpy(bleCmdBuf, v.data(), n); bleCmdBuf[n] = '\0'; bleCmdPending = true;
    portEXIT_CRITICAL(&bleMux);
  }
} dinoBleCharCb;

