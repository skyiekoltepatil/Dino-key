void processBleQueue() {
  if (bleCmdPending) {
    char buf[192];
    portENTER_CRITICAL(&bleMux); strncpy(buf, bleCmdBuf, sizeof(buf) - 1); buf[sizeof(buf) - 1] = '\0'; bleCmdPending = false; portEXIT_CRITICAL(&bleMux);
    executeSyncCommand(String(buf), "BLE");
  }
  if (bleSvcChangedPending && bleClientConnected) { bleSvcChangedPending = false; ble_svc_gatt_changed(0x0001, 0xffff); }
  if (bleCtsLogAuth) { bleCtsLogAuth = false; Serial.println(F("[BLE] Paired -> discovering CTS (0x1805)")); }
  if (bleCtsLogFound) { bleCtsLogFound = false; Serial.printf("[BLE:CTS] Found 0x1805 %u..%u\n", bleCtsSvcStart, bleCtsSvcEnd); }
  if (bleCtsLogNoCts) { bleCtsLogNoCts = false; Serial.printf("[BLE:CTS] No peer CTS (err=%d)\n", bleCtsLastErr); }
  if (bleCtsPending) {
    portENTER_CRITICAL(&bleMux); uint32_t ep = bleCtsLocalEpoch; int32_t tzm = bleCtsTzMin; bool hz = bleCtsHasTz; bleCtsPending = false; portEXIT_CRITICAL(&bleMux);
    if (ep > 1700000000UL) {
      if (hz) tzOffsetMin = tzm;
      setLocalEpoch(ep, "BLE", true, true);
      updateBleStatusValue(true);
    }
  }
  if (bleHostBatPending) {
    portENTER_CRITICAL(&bleMux); uint8_t bv = bleHostBatVal; bleHostBatPending = false; portEXIT_CRITICAL(&bleMux);
    if (bv <= 100) { bleHostBatPct = (float)bv; bleHostBatCharging = false; bleHostBatValid = true; updateBleStatusValue(true); }
  }
  unsigned long now = millis();
  if (bleClientConnected && bleCtsState == CTS_DONE && blePeerBatHandle && !batteryAvailable && bleNextBatPollMs && now >= bleNextBatPollMs) {
    bleNextBatPollMs = now + 60000UL; setCtsState(CTS_READ_BAT_WAIT);
    ble_gattc_read(activeBleConnHandle, blePeerBatHandle, onBleBatReadCb, nullptr);
  }
  if (bleClientConnected && bleCtsState != CTS_IDLE && bleCtsState != CTS_DONE && bleNextCtsProbeMs && now >= bleNextCtsProbeMs) {
    BleCtsState st = bleCtsState; uint16_t ch = activeBleConnHandle;
    if (st == CTS_WAIT_SEC && !bleGotDirectCmd) {
      if (!bleCtsSecStarted) { bleCtsSecStarted = true; NimBLEDevice::startSecurity(ch); bleNextCtsProbeMs = now + 900UL; }
      else {
        ble_gap_conn_desc d;
        if (ble_gap_conn_find(ch, &d) == 0 && d.sec_state.encrypted) { bleCtsEncrypted = true; bleCtsAttempt = 0; setCtsState(CTS_DISC_SVC, 350UL); }
        else if (now - bleConnAtMs >= 10000UL && bleCtsAttempt == 0) setCtsState(CTS_DISC_SVC, 50UL);
        else bleNextCtsProbeMs = now + 1000UL;
      }
    } else if (st == CTS_DISC_SVC && !bleGotDirectCmd) {
      static const ble_uuid16_t u = BLE_UUID16_INIT(0x1805);
      portENTER_CRITICAL(&bleMux); bleCtsState = CTS_DISC_SVC_WAIT; bleCtsSvcStart = bleCtsSvcEnd = 0; portEXIT_CRITICAL(&bleMux);
      ble_gattc_exchange_mtu(ch, nullptr, nullptr);
      if (ble_gattc_disc_svc_by_uuid(ch, &u.u, onBleCtsSvcCb, nullptr) != 0) {
        if (bleCtsAttempt < 10) { bleCtsAttempt++; setCtsState(CTS_DISC_SVC, 2000UL); }
        else { bleCtsLogNoCts = true; setCtsState(CTS_DISC_BAT_SVC, 60UL); }
      }
    } else if (st == CTS_DISC_CHR) {
      portENTER_CRITICAL(&bleMux); bleCtsState = CTS_DISC_CHR_WAIT; bleCtsTimeHandle = bleCtsLocalHandle = 0; portEXIT_CRITICAL(&bleMux);
      if (ble_gattc_disc_all_chrs(ch, bleCtsSvcStart, bleCtsSvcEnd, onBleCtsChrCb, nullptr) != 0) setCtsState(CTS_DISC_BAT_SVC, 40UL);
    } else if (st == CTS_READ_LOCAL) {
      setCtsState(CTS_READ_LOCAL_WAIT);
      if (ble_gattc_read(ch, bleCtsLocalHandle, onBleCtsLocalReadCb, nullptr) != 0) setCtsState(CTS_READ_TIME, 40UL);
    } else if (st == CTS_READ_TIME) {
      setCtsState(CTS_READ_TIME_WAIT);
      if (ble_gattc_read(ch, bleCtsTimeHandle, onBleCtsTimeReadCb, nullptr) != 0) setCtsState(CTS_DISC_BAT_SVC, 40UL);
    } else if (st == CTS_DISC_BAT_SVC) {
      static const ble_uuid16_t u = BLE_UUID16_INIT(0x180F);
      portENTER_CRITICAL(&bleMux); bleCtsState = CTS_DISC_BAT_SVC_WAIT; bleBatSvcStart = bleBatSvcEnd = 0; portEXIT_CRITICAL(&bleMux);
      if (ble_gattc_disc_svc_by_uuid(ch, &u.u, onBleBatSvcCb, nullptr) != 0) setCtsState(CTS_DONE);
    } else if (st == CTS_DISC_BAT_CHR) {
      portENTER_CRITICAL(&bleMux); bleCtsState = CTS_DISC_BAT_CHR_WAIT; blePeerBatHandle = 0; portEXIT_CRITICAL(&bleMux);
      if (ble_gattc_disc_all_chrs(ch, bleBatSvcStart, bleBatSvcEnd, onBleBatChrCb, nullptr) != 0) setCtsState(CTS_DONE);
    } else if (st == CTS_READ_BAT) {
      setCtsState(CTS_READ_BAT_WAIT);
      if (ble_gattc_read(ch, blePeerBatHandle, onBleBatReadCb, nullptr) != 0) setCtsState(CTS_DONE);
    }
  }
}

void setup() {
  Serial.begin(115200);
  delay(300);
  randomSeed(esp_random());
  loadPrefsAndClock();
  initInputPin();

  u8g2.setBusClock(400000);
  u8g2.begin();
  u8g2.setContrast(activeContrast());
  playBootSplash();

  rtcAvailable = rtc.begin();
  if (rtcAvailable) {
    if (rtc.lostPower()) rtc.adjust(cachedNow);
    else { DateTime hw = rtc.now(); if (hw.year() >= 2024) setLocalEpoch(hw.unixtime(), "RTC", true, true); }
  }
  batteryAvailable = maxlipo.begin();
  setupConnectivity();
  updateSensors();
  lastActivityMs = millis();
  Serial.println(F("DINO KEY V1 READY!"));
}

void loop() {
  if (Serial.available()) executeSyncCommand(Serial.readStringUntil('\n'), "USB");
  processBleQueue();
  dnsServer.processNextRequest();
  server.handleClient();
  wifiAndNtpTick();

  unsigned long now = millis();
  InputEvent ev = readInput();
  if (ev != EVT_NONE) {
    lastActivityMs = now;
    if (currentMode == MODE_SLEEP) {
      currentMode = previousMode; u8g2.setContrast(activeContrast());
    } else if (currentMode == MODE_DINO && dinoPlaying) {
      if (ev == EVT_PRESS_DOWN) dinoJump();
      else if (ev == EVT_LONG_PRESS) { dinoPlaying = false; previousMode = currentMode; currentMode = MODE_SLEEP; u8g2.setContrast(15); }
    } else if (!(currentMode == MODE_DINO && (now - dinoOverAt < 800))) {
      if (ev == EVT_SINGLE_CLICK) currentMode = (ScreenMode)((currentMode + 1) % 8);
      else if (ev == EVT_DOUBLE_CLICK) {
        if (currentMode == MODE_DINO) dinoStart();
        else if (currentMode == MODE_CONNECT) { wifiActiveSlot = 0; wifiState = STA_IDLE; }
        else if (currentMode == MODE_STOPWATCH) toggleStopwatch();
        else if (currentMode == MODE_BRIGHTNESS) setBrightnessLevel((brightnessLevel % 5) + 1, true);
        else if (currentMode == MODE_HOME || currentMode == MODE_FULL_FACE) faceIdx = (faceIdx + 1) % 20;
      } else if (ev == EVT_LONG_PRESS) {
        if (currentMode == MODE_STOPWATCH && (swRunning || swAccumMs > 0)) resetStopwatch();
        else { previousMode = currentMode; currentMode = MODE_SLEEP; u8g2.setContrast(15); }
      }
    }
  }

  if (currentMode == MODE_DINO && dinoPlaying) lastActivityMs = now;
  else if (currentMode != MODE_SLEEP && (now - lastActivityMs >= AUTO_SLEEP_MS)) {
    previousMode = currentMode; currentMode = MODE_SLEEP; u8g2.setContrast(15);
  }

  updateSensors();
  if (currentMode == MODE_HOME || currentMode == MODE_FULL_FACE) {
    if (!isBlinking && now >= nextBlinkMs && faceIdx != FACE_SLEEPY_IDX && faceIdx != FACE_SLEEPING_IDX) { isBlinking = true; blinkEndMs = now + 140; }
    if (isBlinking && now >= blinkEndMs) { isBlinking = false; nextBlinkMs = now + random(2500, 5500); }
  } else isBlinking = false;

  if (currentMode == MODE_DINO && dinoPlaying) dinoUpdate();

  if (now - lastFrameMs >= ((currentMode == MODE_SLEEP) ? 1000UL : 20UL)) {
    lastFrameMs = now;
    u8g2.clearBuffer(); u8g2.setDrawColor(1);
    switch (currentMode) {
      case MODE_HOME:       renderHome(); break;
      case MODE_CLOCK:      renderClock(); break;
      case MODE_STOPWATCH:  renderStopwatch(); break;
      case MODE_BATTERY:    renderBattery(); break;
      case MODE_DINO:       renderDino(); break;
      case MODE_FULL_FACE:  renderFullFace(); break;
      case MODE_CONNECT:    renderConnect(); break;
      case MODE_BRIGHTNESS: renderBrightness(); break;
      case MODE_SLEEP:      renderSleep(); break;
    }
    u8g2.sendBuffer();
  }
}
