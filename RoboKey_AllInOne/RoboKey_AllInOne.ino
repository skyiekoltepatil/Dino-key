  server.on("/api/clearwifi", HTTP_GET, []() { clearWifiCredentials(); server.send(200, "text/plain", "Saved Wi-Fi cleared."); });
  server.on("/api/cmd", HTTP_GET, []() {
    if (server.hasArg("mode")) { int m = server.arg("mode").toInt(); if (m >= 0 && m < 8) currentMode = (ScreenMode)m; }
