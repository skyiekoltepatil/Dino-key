  });
  server.onNotFound([]() { server.sendHeader("Location", "http://192.168.4.1/", true); server.send(302, "text/plain", ""); });
  server.begin();
  if (MDNS.begin("dinokey")) MDNS.addService("http", "tcp", 80);
  Serial.printf("[WIFI] AP %s (ok=%d) http://%s\n", AP_SSID, apOk ? 1 : 0, WiFi.softAPIP().toString().c_str());
}

bool syncTimeViaHttpDate() {
  static const char* hosts[] = {"captive.apple.com", "clients3.google.com"};
  static const char* paths[] = {"/hotspot-detect.html", "/generate_204"};
  for (int i = 0; i < 2; i++) {
    WiFiClient c; c.setTimeout(1500);
    if (!c.connect(hosts[i], 80)) continue;
    c.print(String("HEAD ") + paths[i] + " HTTP/1.0\r\nHost: " + hosts[i] + "\r\nConnection: close\r\n\r\n");
    unsigned long t0 = millis();
    while (c.connected() && !c.available() && (millis() - t0 < 1500UL)) delay(5);
    while (c.available()) {
      String line = c.readStringUntil('\n'); line.trim();
      if (line.startsWith("Date:") || line.startsWith("date:")) {
        char mon[8] = {0}; int d, y, hh, mm, ss;
        const char* p = strchr(line.c_str(), ',');
        if (p && sscanf(p + 1, " %d %3s %d %d:%d:%d", &d, mon, &y, &hh, &mm, &ss) == 6 && y >= 2024) {
          const char* mos = "JanFebMarAprMayJunJulAugSepOctNovDec";
          if (const char* f = strstr(mos, mon)) {
            c.stop();
            applyUtcAndTz(DateTime(y, (int)((f - mos) / 3) + 1, d, hh, mm, ss).unixtime(), tzOffsetMin, "NET");
            return true;
          }
        }
      }
      if (line.length() == 0) break;
    }
    c.stop();
  }
  return false;
}

void wifiAndNtpTick() {
#if ENABLE_WIFI_NTP
  unsigned long now = millis();
  if (WiFi.status() == WL_CONNECTED) {
    if (wifiState != STA_CONNECTED) {
      wifiState = STA_CONNECTED; staConnectedAtMs = now; lastHttpTimeTryMs = lastNtpSyncMs = 0;
      if (!sntpStarted) { configTime(0, 0, "pool.ntp.org", "time.google.com", "time.apple.com"); sntpStarted = true; }
    }
    if (time(nullptr) > 1700000000) {
      if (!ntpSynced || (now - lastNtpSyncMs >= 1800000UL)) {
        ntpSynced = true; lastNtpSyncMs = now;
        applyUtcAndTz((uint32_t)time(nullptr), tzOffsetMin, "NTP");
        updateBleStatusValue(true);
      }
    } else if ((!timeSyncedLive || timeSource == "NVS" || timeSource == "EST") &&
               (now - staConnectedAtMs >= 3000UL) && (!lastHttpTimeTryMs || (now - lastHttpTimeTryMs >= 15000UL))) {
      lastHttpTimeTryMs = now;
      if (syncTimeViaHttpDate()) { ntpSynced = true; lastNtpSyncMs = now; updateBleStatusValue(true); }
    }
    return;
  }
  if (wifiState == STA_CONNECTED) { wifiState = STA_COOLDOWN; wifiStateMs = now; }
  if (!hasAnyWifiConfigured()) { wifiState = STA_IDLE; return; }
  if (wifiState == STA_IDLE) {
    String s, p;
    for (int i = 0; i < 3; i++) {
      if (getSlotCreds(wifiActiveSlot, s, p)) { activeStaSsid = s; WiFi.begin(s.c_str(), p.c_str()); wifiState = STA_CONNECTING; wifiStateMs = now; return; }
      wifiActiveSlot = (wifiActiveSlot + 1) % 3;
    }
  } else if (wifiState == STA_CONNECTING && (now - wifiStateMs >= 12000UL)) {
    WiFi.disconnect(false); wifiActiveSlot = (wifiActiveSlot + 1) % 3;
    wifiState = (wifiActiveSlot == 0) ? STA_COOLDOWN : STA_IDLE; wifiStateMs = now;
  } else if (wifiState == STA_COOLDOWN && (now - wifiStateMs >= 45000UL)) {
    wifiActiveSlot = 0; wifiState = STA_IDLE;
  }
#endif
}

void updateSensors() {
  unsigned long now = millis();
  if (now - lastSoftTickMs >= 1000UL) {
    uint32_t d = (now - lastSoftTickMs) / 1000UL;
    softEpochSaved += d; lastSoftTickMs += d * 1000UL;
  }
  if (now - lastNvsSaveMs >= 60000UL) { lastNvsSaveMs = now; prefs.putULong("epoch", softEpochSaved); }
  if (now - lastRtcPoll >= 1000) {
    lastRtcPoll = now;
    if (rtcAvailable) {
      cachedNow = rtc.now(); softEpochSaved = cachedNow.unixtime(); timeSyncedLive = true;
      if (timeSource != "NTP" && timeSource != "BLE" && timeSource != "WEB") timeSource = "RTC";
    } else {
      if (now - lastHwRetryMs >= 10000UL) { lastHwRetryMs = now; rtcAvailable = rtc.begin(); }
      cachedNow = rtcAvailable ? rtc.now() : DateTime(softEpochSaved);
    }
  }
  if (now - lastBatPoll >= 5000) {
    lastBatPoll = now;
    if (batteryAvailable) {
      float p = maxlipo.cellPercent(), v = maxlipo.cellVoltage(); batChargeRate = maxlipo.chargeRate();
      if (!isnan(p) && p >= 0.0f && p <= 150.0f) {
        batPercent = constrain(p, 0.0f, 100.0f); batVoltage = v;
        if (bleClientConnected && (uint8_t)batPercent != lastBleBatSent) updateBleStatusValue(true);
      } else batteryAvailable = maxlipo.begin();
    } else batteryAvailable = maxlipo.begin();
  }
}

