}

uint32_t getStopwatchMs() { return swAccumMs + (swRunning ? (uint32_t)(millis() - swStartMs) : 0); }
void toggleStopwatch() {
  unsigned long now = millis();
  if (swRunning) { swAccumMs += (uint32_t)(now - swStartMs); swRunning = false; }
  else { swStartMs = now; swRunning = true; }
}
void resetStopwatch() { swRunning = false; swAccumMs = 0; swStartMs = 0; }

void drawFaceFromTable(int idx, bool fullScreen) {
  idx = constrain(idx, 0, 19);
  const uint16_t* offs = fullScreen ? FULL_OFFSETS : HOME_OFFSETS;
  const uint16_t* lens = fullScreen ? FULL_LENGTHS : HOME_LENGTHS;
  const uint8_t* spans = fullScreen ? FULL_SPANS : HOME_SPANS;
  uint16_t off = pgm_read_word(&offs[idx]), len = pgm_read_word(&lens[idx]);
  u8g2.setDrawColor(1);
  for (uint16_t i = 0; i < len; i++) {
    uint32_t b = (uint32_t)(off + i) * 3;
    u8g2.drawHLine(pgm_read_byte(&spans[b]), pgm_read_byte(&spans[b + 1]), pgm_read_byte(&spans[b + 2]));
  }
}

void drawDinoStep(int x, int y, bool step) {
  u8g2.setDrawColor(1); u8g2.drawBox(x + 5, y, 6, 4);
  u8g2.setDrawColor(0); u8g2.drawPixel(x + 9, y + 1);
  u8g2.setDrawColor(1);
  u8g2.drawBox(x + 2, y + 3, 6, 6);
  u8g2.drawBox(x, y + 4, 2, 2);
  u8g2.drawPixel(x + 8, y + 5);
  u8g2.drawBox(x + 3, y + 9, 2, step ? 1 : 2);
  u8g2.drawBox(x + 6, y + 9, 2, step ? 2 : 1);
}

void playBootSplash() {
  for (int f = 0; f < 16; f++) {
    u8g2.clearBuffer();
    u8g2.setDrawColor(1);
    u8g2.drawHLine(0, GROUND_Y, 128);
    drawDinoStep(6 + f, GROUND_Y - DINO_H, (f < 14) && ((f % 2) == 1));
    u8g2.setFont(u8g2_font_logisoso16_tr);
    u8g2.drawStr((128 - u8g2.getStrWidth(BOOT_TITLE)) / 2, 24, BOOT_TITLE);
    u8g2.setFont(u8g2_font_5x7_tf);
    u8g2.drawStr((128 - u8g2.getStrWidth(BOOT_OWNER)) / 2, 36, BOOT_OWNER);
    u8g2.drawStr(78, 53, BOOT_VERSION);
    u8g2.sendBuffer();
    delay(95);
  }
  delay(250);
}

float dinoSpeed() { return min(160.0f, 60.0f + dinoScore * 0.15f); }
void placeCactus(int i, float afterX) {
  cacti[i].x = afterX + dinoSpeed() * 0.6f + random(25, 75);
  cacti[i].w = random(4, 8); cacti[i].h = random(8, 15);
}
void dinoStart() {
  dinoPlaying = true; dinoScore = 0; dinoDist = dinoY = dinoVy = groundShift = 0;
  placeCactus(0, 110); placeCactus(1, cacti[0].x); dinoLastFrame = millis();
}
void dinoJump() { if (dinoY <= 0.0f) dinoVy = 230.0f; }
void dinoUpdate() {
  if (!dinoPlaying) return;
  uint32_t t = millis(); float dt = min(0.05f, (t - dinoLastFrame) / 1000.0f); dinoLastFrame = t;
  if (dinoY > 0.0f || dinoVy > 0.0f) { dinoVy -= 900.0f * dt; dinoY += dinoVy * dt; if (dinoY <= 0.0f) dinoY = dinoVy = 0.0f; }
  float sp = dinoSpeed(); dinoDist += sp * dt; dinoScore = (uint32_t)(dinoDist / 5.0f); groundShift += sp * dt;
  for (int i = 0; i < 2; i++) {
    cacti[i].x -= sp * dt;
    if (cacti[i].x + cacti[i].w < 0) placeCactus(i, max(cacti[0].x, cacti[1].x));
    int dTop = GROUND_Y - DINO_H - (int)dinoY + 2, dBot = GROUND_Y - (int)dinoY, cTop = GROUND_Y - cacti[i].h;
    if (DINO_X + 2 < cacti[i].x + cacti[i].w && DINO_X + DINO_W - 2 > cacti[i].x && dBot > cTop && dTop < GROUND_Y) {
      dinoPlaying = false; dinoOverAt = t;
      if (dinoScore > dinoBest) { dinoBest = dinoScore; prefs.putULong("dino_hi", dinoBest); }
    }
  }
}

void initInputPin() {
#if INPUT_AUTO_DETECT
  pinMode(PIN_INPUT, INPUT_PULLUP); delay(5); int vUp = digitalRead(PIN_INPUT);
  pinMode(PIN_INPUT, INPUT_PULLDOWN); delay(5); int vDn = digitalRead(PIN_INPUT);
  touchActiveHigh = (vUp == LOW && vDn == LOW);
  Serial.println(touchActiveHigh ? F("[INPUT] Auto-detected TTP223 (Active HIGH)") : F("[INPUT] Auto-detected push button (Active LOW)"));
#else
  touchActiveHigh = USE_TOUCH_SENSOR;
#endif
  pinMode(PIN_INPUT, touchActiveHigh ? INPUT : INPUT_PULLUP);
}

InputEvent readInput() {
  static int lastReading = -1, clicks = 0;
  static bool debouncedActive = false, longPressFired = false, pendingPress = false;
  static unsigned long lastDebounceMs = 0, pressStartMs = 0, lastReleaseMs = 0;
  unsigned long now = millis();
  int r = digitalRead(PIN_INPUT);
  if (lastReading == -1) lastReading = r;
  if (r != lastReading) lastDebounceMs = now;
  lastReading = r;
  bool activeNow = touchActiveHigh ? (r == HIGH) : (r == LOW);
  if (now - lastDebounceMs >= 20 && activeNow != debouncedActive) {
    debouncedActive = activeNow;
    if (debouncedActive) { pressStartMs = now; longPressFired = false; pendingPress = true; }
    else if (!longPressFired) { clicks++; lastReleaseMs = now; }
  }
  if (pendingPress) { pendingPress = false; return EVT_PRESS_DOWN; }
  if (debouncedActive && !longPressFired && (now - pressStartMs >= 700)) { longPressFired = true; clicks = 0; return EVT_LONG_PRESS; }
  if (clicks > 0 && !debouncedActive) {
    if (clicks >= 2) { clicks = 0; return EVT_DOUBLE_CLICK; }
    if (now - lastReleaseMs >= 300) { clicks = 0; return EVT_SINGLE_CLICK; }
  }
  return EVT_NONE;
}

void formatDateStr(char* buf, size_t len) {
  static const char* days[] = {"SUN","MON","TUE","WED","THU","FRI","SAT"};
  static const char* mons[] = {"JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"};
  snprintf(buf, len, "%s %02d %s", days[constrain(cachedNow.dayOfTheWeek(), 0, 6)],
           cachedNow.day(), mons[constrain(cachedNow.month() - 1, 0, 11)]);
}

void formatTimeStr(char* buf, size_t len, bool withSec) {
  int h = cachedNow.hour(), m = cachedNow.minute(), s = cachedNow.second();
  if (withSec) {
    if (DEFAULT_12H_FORMAT) { h %= 12; if (h == 0) h = 12; }
    snprintf(buf, len, "%02d:%02d:%02d", h, m, s);
  } else if (DEFAULT_12H_FORMAT) {
    int dh = h % 12; if (dh == 0) dh = 12;
    snprintf(buf, len, "%02d:%02d %s", dh, m, (h >= 12) ? "PM" : "AM");
  } else {
    snprintf(buf, len, "%02d:%02d", h, m);
  }
}

void setLocalEpoch(uint32_t localSec, const char* src, bool persist = true, bool live = true) {
  softEpochSaved = localSec; lastSoftTickMs = millis(); cachedNow = DateTime(localSec); timeSource = src;
  if (live) timeSyncedLive = true;
  if (rtcAvailable && live) rtc.adjust(cachedNow);
  if (persist) {
    prefs.putULong("epoch", localSec); prefs.putLong("tzmin", tzOffsetMin); prefs.putString("sync_src", timeSource);
    lastNvsSaveMs = millis();
  }
}

void applyUtcAndTz(uint32_t utcSec, int32_t tzMin, const char* src) {
  tzOffsetMin = tzMin;
  int64_t l64 = (int64_t)utcSec + (int64_t)tzOffsetMin * 60LL;
  if (l64 > 1700000000LL) setLocalEpoch((uint32_t)l64, src, true, true);
}

